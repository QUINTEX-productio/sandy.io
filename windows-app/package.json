{
  "name": "sandy-windows-app",
  "version": "0.1.0-alpha",
  "displayVersion": "ver Alpha",
  "description": "Sandy — AI Sitting Posture Detection Desktop App for Windows",
  "main": "main.js",
  "author": "QUINTEX Production",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:win-all": "electron-builder --win nsis portable"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.quintex.sandy.windows",
    "productName": "Sandy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "Sandy-Setup-Alpha-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sandy",
      "runAfterFinish": true
    }
  }
}
